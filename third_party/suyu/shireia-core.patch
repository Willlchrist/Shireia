 private:
+    void MigrateDirectory(const fs::path& old_path, const fs::path& new_path) {
+        std::error_code error;
+        const bool old_exists = fs::exists(old_path, error);
+        if (error) {
+            LOG_ERROR(Common_Filesystem, "Failed to inspect legacy data directory '{}': {}",
+                      PathToUTF8String(old_path), error.message());
+            return;
+        }
+        if (!old_exists) {
+            return;
+        }
+
+        const bool new_exists = fs::exists(new_path, error);
+        if (error) {
+            LOG_ERROR(Common_Filesystem, "Failed to inspect Shireia data directory '{}': {}",
+                      PathToUTF8String(new_path), error.message());
+            return;
+        }
+        if (new_exists) {
+            LOG_WARNING(Common_Filesystem,
+                        "Both legacy and Shireia data directories exist; keeping both unchanged: "
+                        "'{}' and '{}'",
+                        PathToUTF8String(old_path), PathToUTF8String(new_path));
+            return;
+        }
+
+        fs::rename(old_path, new_path, error);
+        if (error) {
+            LOG_ERROR(Common_Filesystem, "Failed to migrate data directory '{}' to '{}': {}",
+                      PathToUTF8String(old_path), PathToUTF8String(new_path), error.message());
+            return;
+        }
+        LOG_INFO(Common_Filesystem, "Migrated data directory '{}' to '{}'",
+                 PathToUTF8String(old_path), PathToUTF8String(new_path));
+    }
+
